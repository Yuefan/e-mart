# ---- Copy to .env.local (Next.js) and .env (Prisma CLI) ----
# Quick start:  npm run setup:env   (generates the two secrets for you)

# PostgreSQL. docker-compose builds this from POSTGRES_* below and ignores
# whatever is set here — this value is for running the app outside compose
# (local dev against a container, or a hosted Postgres like Neon).
DATABASE_URL="postgresql://app:app@localhost:5432/marketing?schema=public"

# Read by docker-compose only.
POSTGRES_USER="app"
POSTGRES_PASSWORD=""
POSTGRES_DB="marketing"

# Public base URL of this app. Must match the Google redirect URI origin.
# Production: https://your-domain — see docs/deployment.md
APP_URL="http://localhost:3000"

# Only read by docker-compose, for the TLS certificate Caddy provisions.
APP_DOMAIN=""

# 32-byte hex key for AES-256-GCM credential encryption (64 hex chars).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# 32-byte hex secret for signing the session JWT.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Google Cloud OAuth 2.0 client (Web application).
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/connections/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- AI gateway (spec §6.1) ----
# The SEO audit runs without these — you get every rule-engine finding, just no
# prioritisation or rewrites. See docs/ai-gateway-setup.md.
#
# Leave AI_BASE_URL empty to call api.anthropic.com directly. Set it to your
# relay's Anthropic-compatible base (New API / LiteLLM both expose one), e.g.
#   AI_BASE_URL="https://your-relay.example.com"
# It must serve /v1/messages, not only OpenAI's /v1/chat/completions.
AI_BASE_URL=""
AI_API_KEY=""

# How the model is made to return JSON.
#   native (default) - Anthropic's output_config. Constrains decoding, but only
#                      Anthropic implements it.
#   tool             - forces a tool call instead. Use this for every
#                      third-party endpoint.
# This matters more than it looks: compatible endpoints accept output_config,
# ignore it, and answer in prose with a 200. Nothing errors — every AI call
# just fails schema validation, which reads like a broken model rather than a
# wrong setting. For DeepSeek: AI_STRUCTURED_MODE="tool".
AI_STRUCTURED_MODE="native"

# claude-opus-5 is the strong default. claude-sonnet-5 is ~40% the cost per
# token if the audit quality holds for your sites — swap and compare.
# DeepSeek via https://api.deepseek.com/anthropic:
#   AI_MODEL_ANALYSIS="deepseek-v4-pro"   AI_MODEL_FAST="deepseek-v4-flash"
# (deepseek-chat / deepseek-reasoner were deprecated on 2026-07-24.)
AI_MODEL_ANALYSIS="claude-opus-5"
AI_MODEL_FAST="claude-haiku-4-5"

# low | medium | high | xhigh | max. Higher means deeper reasoning and more
# tokens; medium is the cost-conscious starting point for this workload.
# Only applies in native mode — third-party endpoints ignore it.
AI_EFFORT="medium"

# Hard monthly ceiling. Audits stop starting once month-to-date spend hits it.
AI_MAX_MONTHLY_USD="50"

# ---- email (audit reports) --------------------------------------------------
# Optional. Without both of these nothing is emailed, and the notifications
# panel says so instead of failing when a report is due.
#
# EMAIL_FROM must use a domain verified in Resend — it has no safe default, and
# an unverified domain is rejected at send time. See docs/email-setup.md.
RESEND_API_KEY=""
EMAIL_FROM=""
