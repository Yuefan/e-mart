{
  "name": "e-mart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_USE_ENV_PROXY=1 next dev",
    "worker": "cross-env NODE_USE_ENV_PROXY=1 tsx src/worker/index.ts",
    "ai:check": "cross-env NODE_USE_ENV_PROXY=1 tsx scripts/ai-check.ts",
    "build": "next build",
    "start": "cross-env NODE_USE_ENV_PROXY=1 next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "setup:env": "node scripts/setup-env.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "jose": "^6.2.4",
    "marked": "^18.0.7",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
