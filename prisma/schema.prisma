// AI Marketing Dashboard — data model (spec §3)
//
// PostgreSQL. JSON columns are real jsonb, scopes is a text[], and provider is
// an enum — the SQLite build flattened all three into strings.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (Migrate) and is
// supplied to PrismaClient via a driver adapter (see src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

enum Provider {
  GOOGLE
  CLOUDFLARE
  GITHUB
  SHOPIFY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  /// Where audit reports go. Deliberately separate from `email`: the Google
  /// address that signs you in is not necessarily the one you want reports at,
  /// and it arrives already trusted — this one has to prove itself.
  notifyEmail String?
  /// Null means unverified. Nothing is ever sent to an unverified address, so
  /// this app cannot be used to mail someone who did not opt in.
  notifyEmailVerifiedAt DateTime?
  /// Lets reports be paused without losing the verified address.
  notifyOnAudit Boolean @default(true)

  /// UI language, mirrored from the locale cookie so background jobs can pick
  /// a language for email — a worker has no request and therefore no cookie.
  locale String @default("en")

  sites             Site[]
  connections       Connection[]
  emailVerifications EmailVerification[]
}

/// A pending "is this address yours?" challenge.
model EmailVerification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Kept alongside the token: the address is only written to the user record
  /// once the matching link is opened, so a typo cannot silently take effect.
  email String

  /// SHA-256 of the token, never the token itself. A database leak then does
  /// not hand over working verification links.
  tokenHash String @unique

  expiresAt DateTime
  /// Set on use. Present rather than deleting the row so a reused link can be
  /// told apart from one that never existed.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Site {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  domain String
  /// { tone, audience, language, coreTopics[], keywords[], forbidden[], wordCountRange, referenceUrls[], imageStyle }
  brandVoice Json?
  createdAt  DateTime @default(now())

  bindings Binding[]
  gscDaily GscDaily[]
  jobRuns  JobRun[]
  audits   SeoAudit[]
  articles Article[]

  @@unique([userId, domain])
}

model Connection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        Provider
  accountLabel    String // "yuffy@gmail.com" / "roarland.myshopify.com"
  encAccessToken  Bytes // AES-256-GCM: iv | tag | ciphertext
  encRefreshToken Bytes?
  expiresAt       DateTime?
  scopes          String[]
  /// { sub, installationId, shop, accountId, ... }
  meta            Json?
  status          String    @default("active") // active | expired | revoked
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bindings Binding[]

  @@unique([userId, provider, accountLabel])
}

model Binding {
  id           String     @id @default(cuid())
  siteId       String
  site         Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// sc-domain:songolab.com | zoneId | owner/repo | shop domain
  resourceId   String
  /// { branch, contentPath, blogId, ... }
  config       Json?
  createdAt    DateTime   @default(now())

  @@unique([siteId, connectionId, resourceId])
}

// ---- GSC data ----
model GscDaily {
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Deliberately a timestamp, not @db.Date. Every row is written at UTC
  /// midnight and read back with toISOString(); a `date` column comes back
  /// through node-postgres as *local* midnight, which shifts the day for any
  /// non-UTC server — and the day is part of this table's primary key.
  date   DateTime
  /// total | query | page | country | device
  dimension   String
  /// "" when dimension = total
  dimValue    String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  @@id([siteId, date, dimension, dimValue])
  @@index([siteId, dimension, date])
}

model JobRun {
  id       String  @id @default(cuid())
  type     String // gsc_sync | seo_audit | token_refresh | health_check | content_ideate | content_generate
  siteId   String?
  site     Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status   String  @default("queued") // queued | running | done | failed
  progress Int     @default(0)
  payload  Json?
  logs     Json?
  error    String?
  attempts Int     @default(0)

  /// Idempotency handle, e.g. "gsc_sync:daily:2026-07-25". A unique index is
  /// what stops a repeatable job running twice for the same period.
  dedupeKey String? @unique

  /// Worker ignores rows until this moment — powers both scheduling and backoff.
  runAfter   DateTime  @default(now())
  startedAt  DateTime  @default(now()) // enqueued at
  claimedAt  DateTime? // picked up by a worker
  finishedAt DateTime?

  @@index([siteId, startedAt])
  @@index([status, runAfter])
}

// ---- SEO audit (spec §5.2) ----
model SeoAudit {
  id          String    @id @default(cuid())
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  triggeredBy String // cron | manual
  status      String // queued | running | done | failed
  score       Int? // 0-100
  summary     String?   @db.Text
  /// The evidence pack sent to the model, kept so a run can be reproduced.
  rawInput    Json?
  /// { model, promptVersion, inputTokens, outputTokens, costUsd }
  aiMeta      Json?
  error       String?   @db.Text
  findings    Finding[]
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([siteId, createdAt])
}

// ---- Content (spec §5.3) ----
model Article {
  id            String  @id @default(cuid())
  siteId        String
  site          Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  excerpt       String? @db.Text
  bodyMd        String  @db.Text
  metaTitle     String?
  metaDesc      String?
  targetKeyword String?
  /// informational | commercial | transactional | navigational
  searchIntent  String?

  coverImageUrl String?
  /// [{ url, alt, prompt, placeholder }]
  images        Json?

  /// draft | review | scheduled | published | failed
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?

  /// The outline the body was written from, kept so a rewrite can reuse it.
  outline Json?
  /// Self-check results — { issues[], unsupportedClaims[], reviewed }
  checks  Json?
  /// { model, promptVersion, inputTokens, outputTokens, costUsd }
  aiMeta  Json?

  targets   PublishTarget[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status, createdAt])
}

model PublishTarget {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  provider  Provider
  /// Shopify article gid / commit sha / deployment id
  externalId  String?
  externalUrl String?
  /// pending | success | failed
  status      String   @default("pending")
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([articleId])
}

model Finding {
  id          String   @id @default(cuid())
  auditId     String
  audit       SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  severity    String // critical | high | medium | low
  category    String // technical | content | onpage | performance | indexing
  url         String?  @db.Text
  title       String   @db.Text
  detail      String   @db.Text
  suggestion  String   @db.Text
  /// Set for rule-engine findings so the UI can show what was measured.
  evidence    Json?
  source      String   @default("ai") // rule | ai
  autoFixable Boolean  @default(false)
  fixPayload  Json?
  status      String   @default("open") // open | fixing | fixed | ignored

  @@index([auditId, severity])
}
